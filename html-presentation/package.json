{
  "name": "slidev-presentation-skill",
  "version": "4.0.0",
  "description": "Slidev Presentation Builder - Markdown to Slidev presentations with dev mode and LLM optimization",
  "main": "scripts/build.js",
  "scripts": {
    "build": "node scripts/build.js",
    "build:slidev": "node scripts/build.js",
    "build:opt": "node scripts/build.js --optimize",
    "build:opt:full": "node scripts/build.js --optimize --optimize-level full",
    "dev": "node scripts/build.js",
    "dev:opt": "node scripts/build.js --optimize",
    "dev:opt:full": "node scripts/build.js --optimize --optimize-level full",
    "optimize": "node scripts/optimizer.js",
    "optimize:basic": "node scripts/optimizer.js --level basic",
    "optimize:full": "node scripts/optimizer.js --level full"
  },
  "keywords": [
    "presentation",
    "slidev",
    "markdown",
    "slides",
    "vue"
  ],
  "author": "Claude Code",
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.0",
    "marked": "^11.2.0"
  },
  "devDependencies": {
    "@slidev/cli": "^52.11.5",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "^0.25.0"
  }
}
