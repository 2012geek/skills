{
  "name": "slidev-presentation-skill",
  "version": "5.0.0",
  "description": "Slidev Presentation Builder - Markdown to Slidev presentations with intelligent content processing",
  "main": "scripts/build.js",
  "scripts": {
    "build": "node scripts/build.js",
    "build:slidev": "node scripts/build.js",
    "build:opt": "node scripts/build.js --optimize",
    "build:opt:full": "node scripts/build.js --optimize --optimize-level full",
    "dev": "node scripts/build.js",
    "dev:opt": "node scripts/build.js --optimize",
    "dev:opt:full": "node scripts/build.js --optimize --optimize-level full",
    "optimize": "node scripts/optimizer.js",
    "optimize:basic": "node scripts/optimizer.js --level basic",
    "optimize:full": "node scripts/optimizer.js --level full",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "health": "node -e '(async () => { const { HealthChecker } = require(\"./core/index.js\"); const checker = new HealthChecker(); const report = await checker.check(); console.log(JSON.stringify(report, null, 2)); })()'",
    "verify:slide": "node scripts/verify-debug.js",
    "generate": "node cli.js generate",
    "analyze": "node cli.js analyze",
    "recommend": "node cli.js recommend",
    "preview": "node cli.js preview",
    "export": "node cli.js export"
  },
  "keywords": [
    "presentation",
    "slidev",
    "markdown",
    "slides",
    "vue"
  ],
  "author": "Claude Code",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "chokidar": "^3.6.0",
    "commander": "^11.1.0",
    "js-yaml": "^4.1.0",
    "marked": "^11.2.0",
    "open": "^11.0.0",
    "puppeteer": "^24.37.3"
  },
  "devDependencies": {
    "@slidev/cli": "^52.11.5",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "^0.25.0",
    "jest": "^30.2.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "core/**/*.js",
      "lib/**/*.js",
      "preview/**/*.js"
    ]
  }
}
